{
  "name": "kinti",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "kinti": "bin/kinti.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    ".next/",
    "bin/",
    "drizzle/",
    "next.config.mjs"
  ],
  "scripts": {
    "prepack": "node -e \"['cache','dev'].forEach(d=>{try{require('fs').rmSync(require('path').join('.next',d),{recursive:true,force:true})}catch{}})\"",
    "dev": "next dev -p 4000",
    "build": "next build --webpack",
    "start": "next start -p 4000",
    "typecheck": "npx tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node -e \"require('fs').mkdirSync('data',{recursive:true})\" && drizzle-kit migrate",
    "db:seed": "tsx src/lib/db/seed/run.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tanstack/react-query": "^5.104.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "downshift": "^9.4.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "pino-roll": "^4.0.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-joyride": "^3.2.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "swagger-ui-dist": "^5.33.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "update-notifier": "^7.3.1",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/kill-port": "^2.0.3",
    "@types/node": "^24.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
