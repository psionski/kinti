# Base URL of the app — used to construct absolute receipt image URLs for MCP clients.
# Change this to your public domain in production (e.g. https://kinti.example.com).
BASE_URL=http://localhost:4000

# Path to the SQLite database file
DATABASE_URL=./data/kinti.db

# Logging — level: fatal | error | warn | info | debug | trace
# Defaults to 'info' in production, 'debug' in development.
LOG_LEVEL=info

# Directory for auto-rotated log files (created automatically)
LOG_DIR=./logs

# Minimum gap, in milliseconds, between two outbound requests to the same
# market-data provider. Free tiers throttle per-second bursts as well as daily
# quotas; the default of 1500 keeps the nightly price refresh clear of both.
# Set to 0 to disable pacing (paid keys that allow bursts).
PROVIDER_MIN_INTERVAL_MS=1500
